rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User-owned deleted media staging (no executable files)
    match /deleted_media/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || request.resource.contentType.matches('image/.*|video/.*'));
    }

    // User-owned media files (images & videos only, no HTML/JS/executables)
    match /media/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (request.resource == null || request.resource.contentType.matches('image/.*|video/.*'));
    }

    // Payment slips: user can only upload image/PDF slips prefixed with their own uid
    match /slips/{slipFile} {
      allow write: if request.auth != null
                   && slipFile.matches('^' + request.auth.uid + '_.*')
                   && (request.resource == null || request.resource.contentType.matches('image/.*|application/pdf'));
      allow read: if request.auth != null;
    }

    // Legacy large map JSON fallback (JSON only)
    match /maps/{mapFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.resource == null || request.resource.contentType == 'application/json');
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
